{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "retainx-api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "retainx-api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "retainx-api"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "retainx-api"
      }
    },
    {
      "source": "/openapi.json",
      "destination": {
        "service": "retainx-api"
      }
    },
    {
      "source": "/assets/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/images/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
